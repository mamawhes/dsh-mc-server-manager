{
  "name": "dsh-minecraft-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft (Paper) server manager for DeepSeek Harness: sidebar panel, process control, plugins, worlds and backups, server.properties and gamerules, plus agent tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "minecraft",
    "paper"
  ],
  "license": "MIT"
}
